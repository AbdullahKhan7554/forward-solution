# Web3Forms access key for the contact form (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=

# Public site origin, no trailing slash — invite links land on <this>/admin/login.
# Falls back to the Vercel deployment URL when unset.
NEXT_PUBLIC_SITE_URL=https://agriprompakistan.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron secret — /api/keep-alive requires "Authorization: Bearer <this>" (Vercel sends it automatically)
CRON_SECRET=
